<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Spreadsheet_lab1.MainPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="10" RowSpacing="10" Padding="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollView Orientation="Horizontal" Grid.Row="0" Grid.Column="0">
                <HorizontalStackLayout Spacing="5">
                    <Button Text="Зберегти" Clicked="SaveButton_Clicked" BackgroundColor="#915FBA" TextColor="White" />
                    <Button Text="Завантажити" Clicked="LoadButton_Clicked" BackgroundColor="#915FBA" TextColor="White" />
                    <Button Text="G-Drive: Зберегти" Clicked="SaveGoogle_Clicked" BackgroundColor="#915FBA" TextColor="White" />
                    <Button Text="G-Drive: Завантажити" Clicked="LoadGoogle_Clicked" BackgroundColor="#915FBA" TextColor="White" />
                    <BoxView WidthRequest="1" Color="Gray" Margin="5,0" />
                    <Button Text="Порахувати" Clicked="CalculateButton_Clicked" BackgroundColor="#915FBA" TextColor="White" />
                    <Button x:Name="modeBtn" Text="Режим: ЗНАЧЕННЯ" Clicked="SwitchModeButton_Clicked" BackgroundColor="#915FBA" TextColor="White" />
                </HorizontalStackLayout>
            </ScrollView>

            <Button Grid.Row="0" Grid.Column="1" Text="Вийти" Clicked="ExitButton_Clicked" BackgroundColor="#C62828" TextColor="White" WidthRequest="100" HorizontalOptions="Fill" />

            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="5">
                <Button Text="+ Рядок" Clicked="AddRowButton_Clicked" BackgroundColor="#404040" TextColor="White" />
                <Button Text="− Рядок" Clicked="DeleteRowButton_Clicked" BackgroundColor="#404040" TextColor="White" />
                <BoxView WidthRequest="1" Color="Gray" Margin="5,0" />
                <Button Text="+ Стовпець" Clicked="AddColumnButton_Clicked" BackgroundColor="#404040" TextColor="White" />
                <Button Text="− Стовпець" Clicked="DeleteColumnButton_Clicked" BackgroundColor="#404040" TextColor="White" />
            </HorizontalStackLayout>

            <Button Grid.Row="1" Grid.Column="1" Text="Довідка" Clicked="HelpButton_Clicked" BackgroundColor="#505050" TextColor="White" WidthRequest="100" HorizontalOptions="Fill" />
        </Grid>

        <Grid Grid.Row="1" Margin="10,0,10,10" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label x:Name="addressLabel" Text="" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" Margin="0,0,10,0" />

            <Entry x:Name="textInput" Grid.Column="1" Placeholder="Виберіть клітинку та введіть вираз..." Completed="CalculateButton_Clicked"/>
        </Grid>

        <ScrollView Grid.Row="2" Orientation="Both">
            <Grid x:Name="grid" Margin="5">
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>